#!/usr/bin/env bash
#MISE description="Delete the arkham-dev machine; the next routed task runs sandbox:init again"
#MISE tags=["sandbox"]
#MISE dir="{{config_root}}"

set -euo pipefail

name="${ARKHAM_SANDBOX:?set by mise.arch.toml}"
if smolvm machine status --name "$name"; then
  smolvm machine delete --name "$name" --force
fi
rm -f target/sandbox/arkham-dev.ready
