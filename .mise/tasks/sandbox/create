#!/usr/bin/env bash
#MISE description="Build the sandbox image and create a fresh arkham-dev machine"
#MISE tags=["sandbox"]
#MISE dir="{{config_root}}"

set -euo pipefail

if smolvm machine status --name arkham-dev >/dev/null 2>/dev/null; then
  mise run sandbox:destroy
fi
podman build --pull=newer -f Dockerfile.sandbox -t localhost/arkham-dev:local .
podman save --format docker-archive localhost/arkham-dev:local |
  smolvm machine create --name arkham-dev --smolfile ./Smolfile --nested --image -
