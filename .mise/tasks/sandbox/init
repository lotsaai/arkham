#!/usr/bin/env bash
#MISE description="Create the arkham-dev machine from the Smolfile, warm every cache, and stop it"
#MISE tags=["sandbox"]
#MISE dir="{{config_root}}"
#MISE sources=["Smolfile", "mise.toml", "mise.lock", "mise.arch.toml", "mise.arch.lock", "integration/compose.yaml", ".mise/tasks/sandbox/init", ".mise/sandbox-warm.sh"]
#MISE outputs=["target/sandbox/arkham-dev.ready"]

set -euo pipefail

name="${ARKHAM_SANDBOX:?set by mise.arch.toml}"
ready=target/sandbox/arkham-dev.ready
checkout=/home/eng/github/lotsaai/arkham

in_guest() {
  smolvm machine exec --stream --name "$name" --user root -- "$@"
}

rm -f "$ready"
if smolvm machine status --name "$name"; then
  smolvm machine delete --name "$name" --force
fi
# A half-warmed machine is never used: it goes unless the warm step finishes.
trap 'smolvm machine delete --name "$name" --force' EXIT

smolvm machine create --name "$name" --smolfile ./Smolfile --nested --image "$ARKHAM_SANDBOX_IMAGE"
smolvm machine start --name "$name"
for _ in $(seq 1 120); do
  in_guest sh -c 'systemctl is-active --quiet docker && systemctl is-active --quiet containerd' && break
  sleep 1
done
in_guest sh -c 'systemctl is-active --quiet docker && systemctl is-active --quiet containerd'

in_guest su - eng -c "cd $checkout && mise trust --quiet && mise install --quiet && mise exec -- bash .mise/sandbox-warm.sh"

trap - EXIT
smolvm machine stop --name "$name"
mkdir -p "$(dirname "$ready")"
touch "$ready"
