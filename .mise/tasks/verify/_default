#!/usr/bin/env bash
#MISE description="Run every check: lints (check), the test suite (test), then every verify:* user-path check"
#MISE dir="{{config_root}}"

set -euo pipefail
source "$MISE_CONFIG_ROOT/.mise/sandbox.sh"

mise run check
mise run --force test
for feature in fake schemes ca rules config registry http-swap https-swap agent; do
  mise run "verify:$feature"
done
