#!/usr/bin/env bash

#MISE description="Run the live TUN tests (build as user, execute as root)"
#MISE sources=["Cargo.toml", "Cargo.lock", "src/**", "crates/**", "rules/**", ".mise/tasks/test/**"]
#USAGE flag "--use-sudo" help="Skip the gum escalation prompt and go straight to sudo"
#USAGE arg "[filters]" var=#true help="Test-name filters; default: tun_live_"

proj_dir=$(jj root 2>/dev/null || git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

cargo nextest run --locked --no-run --cargo-quiet --package arkham-tun

test_bin=$(cargo nextest list --package arkham-tun --message-format json |
  jq -r '.["rust-suites"] |
  if length == 1 then first(.[]) | .["binary-path"] else error("expected 1 test binary, got \(length)") end')

eval "filters=(${usage_filters:-})"
if [ ${#filters[@]} -eq 0 ]; then
  filters=(tun_live_)
fi

if [ "${usage_use_sudo:-false}" = "true" ]; then
  sudo env ARKHAM_TEST_TUN=1 "$test_bin" --test-threads=1 --ignored "${filters[@]}"
else
  if ! gum confirm "TUN tests need root; escalate with sudo?"; then
    echo "escalation declined; test binary: $test_bin" >&2
    exit 1
  fi
  sudo env ARKHAM_TEST_TUN=1 "$test_bin" --test-threads=1 --ignored "${filters[@]}"
fi
