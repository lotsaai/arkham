#!/usr/bin/env bash

set -euo pipefail

#MISE description="Run the full project test suite"
#MISE sources=["Cargo.toml", "Cargo.lock", "src/**", "crates/**", "rules/**", ".mise/tasks/test/**"]
#MISE depends=["build:container"]

proj_dir=$(jj root 2>/dev/null || git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

mise run test:rust "$@"
mise run test:ssh "$@"
mise run test:ebpf --use-sudo "$@"
mise run test:k3s "$@"
mise run test:talos "$@"
