#!/usr/bin/env bash

set -euo pipefail

#MISE description="Run the full project test suite"
#MISE sources=["Cargo.toml", "Cargo.lock", "src/**", "crates/**", "rules/**", ".mise/tasks/test/**"]

proj_dir=$(jj root 2>/dev/null || git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

mise run --force test:rust "$@"
mise run --force test:ssh "$@"
mise run --force test:tun --use-sudo "$@"
mise run --force test:tproxy --use-sudo "$@"
mise run --force test:ebpf --use-sudo "$@"
mise run --force test:k3s "$@"
mise run --force test:talos "$@"
