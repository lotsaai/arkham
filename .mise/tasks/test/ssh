#!/usr/bin/env bash

#MISE description="Run the docker compose e2e scenarios per capture backend (tproxy, tun)"
#MISE sources=["Cargo.toml", "Cargo.lock", "src/**", "crates/**", "integration/**"]
#MISE depends=["build:debug"]

proj_dir=$(jj root 2>/dev/null || git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

if ! docker version --format '{{.Server.Version}}' >/dev/null 2>&1; then
  echo "skip: test:ssh needs a docker daemon"
  exit 0
fi

# The demo values are throwaways; seed a local .env from the example so a
# fresh checkout runs the scenarios without manual setup (gitignored).
if [ ! -f integration/.env ] && [ -f integration/.env.example ]; then
  cp integration/.env.example integration/.env
  echo "seeded integration/.env from the example"
fi
if [ ! -f integration/.env ]; then
  echo "skip: test:ssh needs integration/.env"
  exit 0
fi
bash integration/gen-nats.sh

# eBPF is not here: it captures by cgroup membership and compose cannot pin
# a service's cgroup path — `ARKHAM_BACKEND=ebpf mise run demo:bwrap` runs
# the same scenarios over eBPF instead.
backends=${ARKHAM_TEST_BACKENDS:-"tproxy tun"}
# Compose interpolates these on every `up` and `down`. Export them for the
# whole loop so a command that does not prefix them does not warn.
HOST_UID="$(id -u)"
HOST_GID="$(id -g)"
export HOST_UID HOST_GID

# The debug binary comes from the `build:debug` dependency; compose mounts
# it from here (the image is runtime-only, no build stage).
mkdir -p integration/docker
cp target/debug/arkham integration/docker/arkham

compose="docker compose -f integration/compose.yaml --env-file integration/.env"
client=arkham-integration-client-1

nats_env_value() {
  local key=$1
  local line value
  line=$(grep -E "^${key}=" integration/out/nats/nats.env || true)
  value=${line#*=}
  value=${value#\'}
  value=${value%\'}
  printf '%s' "$value"
}

# The client container must not hold the real nkey seed or the real user JWT.
# Compare its log with the gitignored material gen-nats.sh wrote on the host.
nats_client_log_hides_real_material() {
  local log_file=$1
  local key value
  for key in NATS_NKEY_REAL_SEED NATS_JWT_REAL_ASSERT; do
    value=$(nats_env_value "$key")
    if [ -z "$value" ]; then
      echo "missing ${key} in integration/out/nats/nats.env"
      return 1
    fi
    if grep -F -q -- "$value" "$log_file"; then
      echo "client log contains ${key}"
      return 1
    fi
  done
}

# Host ~/.config/nats discovery. Start certs, copy its CA, then `arkham init`
# in an empty workspace. That reads the context (no project [rules.nats_*],
# no fnox key) and writes the generated grant. The guest tree is the decoy
# mount. The grant file, which states the real seed, is appended to the
# global config and mounted only on the arkham service.
prepare_nats_discovery() {
  local real_seed home isolate workspace certs_cid status code
  local state_root grant_toml compose_file env_name label dest rel host rest container
  real_seed=$(nats_env_value NATS_NKEY_REAL_SEED)
  if [ -z "$real_seed" ]; then
    echo "missing NATS_NKEY_REAL_SEED in integration/out/nats/nats.env"
    return 1
  fi
  if grep -q 'generated = true' integration/arkham.toml integration/out/arkham.toml; then
    echo "a hand-written nats rule is marked generated"
    return 1
  fi

  echo "=== nats discovery: certs ==="
  $compose up -d certs
  certs_cid=$($compose ps -aq certs)
  certs_cid=${certs_cid%%$'\n'*}
  if [ -z "$certs_cid" ]; then
    echo "certs container is absent"
    return 1
  fi
  status=created
  code=1
  for _ in $(seq 1 300); do
    status=$(docker inspect -f '{{.State.Status}}' "$certs_cid" 2>/dev/null || echo missing)
    if [ "$status" = exited ]; then
      code=$(docker inspect -f '{{.State.ExitCode}}' "$certs_cid" 2>/dev/null || echo 1)
      break
    fi
    sleep 1
  done
  if [ "$status" != exited ] || [ "$code" != 0 ]; then
    echo "certs exited ${code} (status ${status})"
    docker logs "$certs_cid" || true
    return 1
  fi

  isolate=$(mktemp -d /tmp/arkham-nats-discovery.XXXXXX)
  trap 'rm -rf "$isolate"' RETURN
  home=$isolate/home
  workspace=$isolate/workspace
  mkdir -p "$home/.config/nats/context" "$workspace" "$isolate/xdg-config" "$isolate/xdg-state" "$isolate/xdg-data"
  docker cp "$certs_cid":/certs/ca.crt "$home/.config/nats/ca.crt"
  printf '%s\n' "$real_seed" >"$home/.config/nats/user.nk"
  chmod 600 "$home/.config/nats/user.nk"
  printf 'discovered\n' >"$home/.config/nats/context.txt"
  cat >"$home/.config/nats/context/discovered.json" <<EOF
{
  "description": "integration discovery",
  "url": "tls://nats:4222",
  "nkey": "${home}/.config/nats/user.nk",
  "ca": "${home}/.config/nats/ca.crt"
}
EOF

  echo "=== nats discovery: arkham init ==="
  env -u ARKHAM_CONFIG -u KUBECONFIG -u TALOSCONFIG \
    HOME="$home" \
    XDG_CONFIG_HOME="$isolate/xdg-config" \
    XDG_STATE_HOME="$isolate/xdg-state" \
    XDG_DATA_HOME="$isolate/xdg-data" \
    GIT_CONFIG_GLOBAL=/dev/null \
    GIT_CONFIG_SYSTEM=/dev/null \
    integration/docker/arkham init --backend tun "$workspace"

  state_root=$isolate/xdg-state/arkham/ws
  grant_toml=$(find "$state_root" -path '*/grants/arkham.toml' -type f -print -quit)
  compose_file=$(find "$state_root" -name compose.yml -type f -print -quit)
  if [ -z "$grant_toml" ] || [ -z "$compose_file" ]; then
    echo "arkham init did not write a grant layer"
    return 1
  fi
  if ! grep -q 'generated = true' "$grant_toml"; then
    echo "discovered grant is not marked generated"
    return 1
  fi
  if ! grep -q 'if_missing = "ignore"' "$grant_toml"; then
    echo "discovered grant does not ignore a missing fnox key"
    return 1
  fi
  if ! grep -q 'sslrootcert=' "$grant_toml"; then
    echo "discovered grant does not name a CA"
    return 1
  fi
  if [ -z "$(find "$(dirname "$grant_toml")/rules.d" -name 'nats-*.ca' -type f -print -quit)" ]; then
    echo "discovered grant did not copy the CA"
    return 1
  fi
  if ! grep -F -q -- "$real_seed" "$grant_toml"; then
    echo "discovered grant does not state the real nkey"
    return 1
  fi
  env_name=$(grep -m 1 -E '^env = ' "$grant_toml" || true)
  env_name=${env_name#env = }
  env_name=${env_name#\"}
  env_name=${env_name#\'}
  env_name=${env_name%\"}
  env_name=${env_name%\'}
  label=$(grep -m 1 -E '^\[rules\.' "$grant_toml" || true)
  label=${label#\[rules.}
  label=${label%\]}
  if [ -z "$env_name" ] || [ -z "$label" ]; then
    echo "discovered grant has no env name"
    return 1
  fi
  if grep -F -q -- "[rules.${label}]" integration/out/arkham.toml integration/arkham.toml; then
    echo "discovered rule is hand-written in the project config"
    return 1
  fi

  dest=integration/out/nats-discovery
  rm -rf "$dest"
  mkdir -p "$dest/grants" "$dest/guest"
  cp -a "$(dirname "$grant_toml")/." "$dest/grants/"
  while IFS= read -r line; do
    case "$line" in
      *"/home/eng/.config/nats/"*) ;;
      *) continue ;;
    esac
    rest=${line#*- }
    host=${rest%%:*}
    container=${rest#*:}
    container=${container%%:*}
    rel=${container#/home/eng/.config/nats/}
    if [ "$rel" = "$container" ] || [ -z "$rel" ]; then
      echo "unexpected nats mount: ${line}"
      return 1
    fi
    mkdir -p "$dest/guest/$(dirname "$rel")"
    cp "$host" "$dest/guest/$rel"
  done <"$compose_file"
  if [ ! -f "$dest/guest/context.txt" ]; then
    echo "discovery did not mount a nats context into the guest"
    return 1
  fi
  if grep -R -F -q -- "$real_seed" "$dest/guest"; then
    echo "discovered guest tree contains the real nkey"
    return 1
  fi

  $compose run --rm --no-deps -T \
    -v "${grant_toml}:/discovered.toml:ro" \
    --entrypoint bash certs \
    -c 'cat /discovered.toml >> /arkham-config/config.toml'
  docker cp "$certs_cid":/arkham-config/config.toml "$dest/config.toml"
  docker cp "$certs_cid":/arkham-config/fnox.toml "$dest/fnox.toml"
  if ! grep -q 'generated = true' "$dest/config.toml"; then
    echo "global config is missing the discovered grant"
    return 1
  fi
  if grep -F -q -- "[secrets.${env_name}]" "$dest/fnox.toml"; then
    echo "discovered grant env is a fnox secret"
    return 1
  fi
}

for backend in $backends; do
  echo "=== backend: $backend ==="
  # A leftover stack holds an old CA while the rerun rotates the volume, and
  # the first handshake fails on the mismatch; every round starts clean.
  $compose down --remove-orphans -v --timeout 3
  # The bind-mounted file survives `down`. A leftover from the previous
  # backend, or from an earlier run, must not satisfy this round.
  rm -f integration/out/covered.json
  prepare_nats_discovery
  # Certs already completed. Recreating it would rerun gen-secrets.sh and
  # drop the discovered grant from the global config.
  ARKHAM_BACKEND="$backend" NATS_DISCOVERED=1 $compose up -d --build --no-recreate

  # A failed one-shot leaves the client in `created`. Don't spend the
  # rest of the poll on a container that will never start.
  code=""
  state=running
  direct=arkham-integration-smtp-direct-1
  # 389ds creates its instance on first start, then the entry turns on
  # secure binds. That is slower than the other servers; the loop exits
  # as soon as the client does.
  for _ in $(seq 1 300); do
    dstatus=$(docker inspect -f '{{.State.Status}}' "$direct" 2>/dev/null || echo missing)
    if [ "$dstatus" = exited ]; then
      dcode=$(docker inspect -f '{{.State.ExitCode}}' "$direct" 2>/dev/null || echo 1)
      if [ "$dcode" != 0 ]; then
        echo "smtp-direct exited $dcode"
        code=$dcode
        state=exited
        break
      fi
    fi
    state=$(docker inspect -f '{{.State.Status}}' "$client" 2>/dev/null || echo missing)
    [ "$state" = exited ] && break
    [ "$state" = missing ] && break
    sleep 1
  done
  if [ -z "$code" ]; then
    code=$(docker inspect -f '{{.State.ExitCode}}' "$client" 2>/dev/null || echo 1)
    if [ "$state" != exited ]; then
      code=124
    fi
  fi
  docker logs "$client" > /tmp/arkham-client.log 2>&1 || true
  cat /tmp/arkham-client.log
  if ! nats_client_log_hides_real_material /tmp/arkham-client.log; then
    if [ -z "$code" ] || [ "$code" = 0 ]; then
      code=1
    fi
  fi
  if [ "$code" = 0 ]; then
    covered=integration/out/covered.json
    if [ ! -f "$covered" ]; then
      echo "missing $covered"
      code=1
    else
      integration/docker/arkham schemes > /tmp/arkham-schemes.txt
      while IFS= read -r scheme; do
        [ -z "$scheme" ] && continue
        if ! grep -Fq "\"${scheme}\"" "$covered"; then
          echo "scheme ${scheme} has no passing e2e scenario"
          code=1
        fi
      done < /tmp/arkham-schemes.txt
    fi
  fi
  # Capture every service, arkham especially, before teardown. The CI
  # failure step prints this file; compose down would otherwise erase it.
  if [ "$code" != 0 ]; then
    {
      echo "=== compose logs (backend $backend, client exit $code) ==="
      $compose logs --no-color || true
    } | tee -a /tmp/arkham-integration-compose.log
  fi
  $compose down --remove-orphans -v --timeout 3
  if [ "$code" != 0 ]; then
    echo "=== backend $backend FAILED (exit $code) ==="
    exit "$code"
  fi
  echo "=== backend $backend passed ==="
done
