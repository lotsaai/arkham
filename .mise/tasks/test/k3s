#!/usr/bin/env bash

#MISE description="Run the live k3s kubeconfig substitution tests (k3d cluster, bearer, cert, exec)"
#MISE depends=["build:debug"]

proj_dir=$(jj root 2>/dev/null || git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

cluster="arkham-k3s-test"
scratch=$proj_dir/target/k3s-e2e
plugin_dir=""
arkham=$proj_dir/target/debug/arkham
serve_pid=""
# One budget for /readyz, node Ready, and coredns Ready. Cluster create
# (image pull included) is outside it. Override when a runner is slower.
ready_timeout=${ARKHAM_K3S_READY_TIMEOUT:-600}
case "$ready_timeout" in
  ''|*[!0-9]*)
    echo "ARKHAM_K3S_READY_TIMEOUT must be a positive number of seconds, got '${ready_timeout}'" >&2
    exit 1
    ;;
esac
if [ "$((10#$ready_timeout))" -lt 1 ]; then
  echo "ARKHAM_K3S_READY_TIMEOUT must be a positive number of seconds, got '${ready_timeout}'" >&2
  exit 1
fi

run_privileged() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
    return
  fi
  if sudo -n true 2>/dev/null; then
    sudo -n "$@"
    return
  fi
  return 127
}

bpftool_bin() {
  if command -v bpftool >/dev/null 2>&1; then
    command -v bpftool
    return 0
  fi
  local candidate match
  candidate="/usr/lib/linux-tools/$(uname -r)/bpftool"
  if [ -x "$candidate" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi
  match=$(compgen -G '/usr/lib/linux-tools/*/bpftool' || true)
  if [ -n "$match" ]; then
    printf '%s\n' "${match%%$'\n'*}"
    return 0
  fi
  return 1
}

log_elapsed() {
  local stage=$1
  local since_ready=$((SECONDS - ready_started))
  local since_create=$((SECONDS - create_started))
  echo "${stage}: readiness ${since_ready}s / ${ready_timeout}s, ${since_create}s since cluster create started"
}

# The published API's EOF is in the serverlb log. nft, routes, and cgroup
# programs are the host state the capture suites can leave behind. Print
# both before the trap deletes the cluster.
dump_k3s_diagnostics() {
  local name bin
  {
    echo "=== kubeconfig server ==="
    kubectl config view --minify -o 'jsonpath={.clusters[0].cluster.server}' 2>/dev/null || true
    echo
    echo "=== k3d cluster list ==="
    k3d cluster list || true
    echo "=== docker ps (k3d-${cluster}) ==="
    docker ps -a --filter "name=k3d-${cluster}" --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}' || true
    for name in "k3d-${cluster}-server-0" "k3d-${cluster}-serverlb"; do
      echo "=== docker logs ${name} (tail 800) ==="
      docker logs --tail 800 "$name" 2>&1 || true
    done
    echo "=== nft list ruleset ==="
    run_privileged nft list ruleset 2>&1 || echo "nft list ruleset failed"
    echo "=== ip rule ==="
    ip rule show 2>&1 || true
    echo "=== ip route ==="
    ip route show 2>&1 || true
    echo "=== ip route show table 100 ==="
    ip route show table 100 2>&1 || true
    echo "=== bpftool cgroup tree ==="
    if bin=$(bpftool_bin); then
      run_privileged "$bin" cgroup tree 2>&1 || echo "bpftool cgroup tree failed"
    else
      echo "bpftool is not installed; cgroup program attachments were not listed"
    fi
  } >&2
}

cleanup() {
  local status=$?
  if [ "$status" -ne 0 ]; then
    dump_k3s_diagnostics
  fi
  if [ -n "$serve_pid" ]; then
    kill "$serve_pid" 2>/dev/null || true
  fi
  k3d cluster delete "$cluster" >/dev/null 2>&1 || true
  if [ -n "$plugin_dir" ]; then
    rm -rf "$plugin_dir"
  fi
}
trap cleanup EXIT

# Capture suites scope themselves to TEST-NET-2 and a private cgroup, and
# drop that state when the test task is joined. A killed run can still
# leave it. Remove the known leftovers so this cluster is not started
# behind a stale tproxy rule or capture route, and say so when that happens.
sweep_host_capture() {
  local found=0 nft_out line pref cg flushed=0
  if nft_out=$(run_privileged nft list tables 2>/dev/null); then
    if printf '%s\n' "$nft_out" | grep -q 'arkham_tproxy'; then
      echo "host capture residue: nft table inet arkham_tproxy" >&2
      run_privileged nft delete table inet arkham_tproxy >&2 || echo "could not delete nft table inet arkham_tproxy" >&2
      found=$((found + 1))
    fi
  else
    echo "host capture state: nft tables not listed (no root, or nft is missing)" >&2
  fi
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$line" in
      *"fwmark 0x88"*|*"lookup 100"|*"lookup 100 "*)
        echo "host capture residue: ip rule: ${line}" >&2
        pref=${line%%:*}
        run_privileged ip rule del pref "$pref" >&2 || echo "could not delete ip rule pref ${pref}" >&2
        found=$((found + 1))
        case "$line" in
          *"lookup 100"|*"lookup 100 "*)
            if [ "$flushed" -eq 0 ]; then
              run_privileged ip route flush table 100 >&2 || true
              flushed=1
            fi
            ;;
        esac
        ;;
    esac
  done <<<"$(ip rule show 2>/dev/null || true)"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$line" in
      198.51.100.*)
        echo "host capture residue: route: ${line}" >&2
        pref=${line%% *}
        run_privileged ip route del "$pref" >&2 || echo "could not delete route ${pref}" >&2
        found=$((found + 1))
        ;;
    esac
  done <<<"$(ip route show 2>/dev/null || true)"
  while IFS= read -r cg; do
    [ -n "$cg" ] || continue
    echo "host capture residue: cgroup ${cg}" >&2
    run_privileged rmdir "$cg" >&2 || echo "could not remove cgroup ${cg}" >&2
    found=$((found + 1))
  done < <(compgen -G '/sys/fs/cgroup/arkham-test-*' || true)
  if [ "$found" -eq 0 ]; then
    echo "host capture state: clean (no arkham_tproxy table, fwmark 0x88 or table-100 rule, 198.51.100 route, or arkham-test cgroup)"
  else
    echo "host capture state: interference, removed ${found} arkham leftover(s) before cluster create"
  fi
}

rm -rf "$scratch"
mkdir -p "$scratch" "$scratch/config/arkham"

# Isolation: every k3d/kubectl call in this task sees only task-local
# kubeconfig files under $scratch; the user's ~/.kube/config is never
# read, merged, or written.
export KUBECONFIG="$scratch/cert-kubeconfig"
# Stack generation needs `[workspace] home`, which normally arrives via the
# user's global config; the hermetic XDG_CONFIG_HOME hides that file, so the
# task seeds the one value generation requires.
printf '[workspace]\nhome = "%s"\n' "$HOME" >"$scratch/config/arkham/config.toml"

# Fresh cluster every run: leftover state from a killed run must not leak in.
# The kubeconfig flags keep k3d from touching ~/.kube/config even if the
# KUBECONFIG export above were lost.
k3d cluster delete "$cluster" >/dev/null 2>&1 || true
sweep_host_capture
# Publish the API on loopback. k3d's default kubeconfig server is 0.0.0.0,
# a listen address: CI dialed https://0.0.0.0:<port> and the serverlb closed
# every connection with EOF. `random` is k3d's free-port allocation, and the
# same address is what it writes into the kubeconfig and the serving cert.
# --wait returns once the server node has logged readiness and the serverlb
# container is running. nginx can still accept the host port and EOF until
# its apiserver upstream is up; the poll below is that host-side wait.
create_started=$SECONDS
k3d cluster create "$cluster" \
  --wait \
  --api-port 127.0.0.1:random \
  --kubeconfig-update-default=false \
  --kubeconfig-switch-context=false \
  --k3s-arg "--tls-san=127.0.0.1@server:0" \
  --k3s-arg "--tls-san=host.docker.internal@server:0"
echo "k3d cluster create returned after $((SECONDS - create_started))s"

# With update-default off, k3d wrote no kubeconfig anywhere; write its
# store copy to the task file so kubectl has a config to read.
k3d kubeconfig get "$cluster" >"$KUBECONFIG"

server=$(kubectl config view --minify -o 'jsonpath={.clusters[0].cluster.server}')
case "$server" in
  https://127.0.0.1:[0-9]*) ;;
  *)
    echo "kubeconfig server is ${server}; expected https://127.0.0.1:<port>" >&2
    exit 1
    ;;
esac

# kubectl's discovery client retries an EOF about five times, ten seconds
# apart, then exits. `kubectl wait --timeout` does not start until that
# discovery succeeds. Each /readyz probe is a new client, so this loop is
# what spends the budget. The sleep is the gap between probes.
wait_for_apiserver() {
  local errfile=$scratch/readyz.err
  local next_note=0
  local detail
  : >"$errfile"
  while [ "$SECONDS" -lt "$deadline" ]; do
    if kubectl get --raw=/readyz --request-timeout=5s >"$scratch/readyz.out" 2>"$errfile"; then
      log_elapsed "apiserver /readyz ok"
      return 0
    fi
    if [ "$SECONDS" -ge "$next_note" ]; then
      detail=$(tr '\n' ' ' <"$errfile" || true)
      echo "waiting for apiserver /readyz ($((SECONDS - ready_started))s / ${ready_timeout}s): ${detail}" >&2
      next_note=$((SECONDS + 10))
    fi
    sleep 2
  done
  echo "kubernetes apiserver did not report ready within ${ready_timeout}s" >&2
  cat "$errfile" >&2 || true
  return 1
}

wait_for_coredns() {
  local errfile=$scratch/coredns.err
  local next_note=0
  local detail slice left
  : >"$errfile"
  while [ "$SECONDS" -lt "$deadline" ]; do
    left=$((deadline - SECONDS))
    slice=15
    if [ "$left" -lt "$slice" ]; then
      slice=$left
    fi
    if [ "$slice" -lt 1 ]; then
      break
    fi
    # A missing pod makes kubectl wait exit immediately. Keep polling
    # until the budget is gone; the deployment is created after the node.
    if kubectl wait --for=condition=Ready pod -n kube-system -l k8s-app=kube-dns --timeout="${slice}s" >"$scratch/coredns.out" 2>"$errfile"; then
      log_elapsed "coredns Ready"
      return 0
    fi
    if [ "$SECONDS" -ge "$next_note" ]; then
      detail=$(tr '\n' ' ' <"$errfile" || true)
      echo "waiting for coredns ($((SECONDS - ready_started))s / ${ready_timeout}s): ${detail}" >&2
      next_note=$((SECONDS + 10))
    fi
    # Gap between probes when the pod does not exist yet. kubectl wait
    # itself blocks while a pod is present and not Ready.
    sleep 2
  done
  echo "coredns was not Ready within ${ready_timeout}s" >&2
  cat "$errfile" >&2 || true
  return 1
}

ready_started=$SECONDS
deadline=$((ready_started + ready_timeout))
echo "readiness budget ${ready_timeout}s (ARKHAM_K3S_READY_TIMEOUT) for /readyz, nodes, and coredns"
wait_for_apiserver

left=$((deadline - SECONDS))
if [ "$left" -lt 1 ]; then
  echo "no time left in the ${ready_timeout}s budget before nodes were Ready" >&2
  exit 1
fi
echo "waiting for nodes Ready (elapsed $((SECONDS - ready_started))s, remaining ${left}s)"
if ! kubectl wait --for=condition=Ready nodes --all --timeout="${left}s"; then
  echo "nodes were not Ready within the ${ready_timeout}s budget (elapsed $((SECONDS - ready_started))s)" >&2
  exit 1
fi
log_elapsed "nodes Ready"
wait_for_coredns

# Bearer-leg source: token-only copy of the same kubeconfig.
cp "$scratch/cert-kubeconfig" "$scratch/token-kubeconfig"
export KUBECONFIG="$scratch/cert-kubeconfig"
kubectl create serviceaccount arkham-test >/dev/null
kubectl create clusterrolebinding arkham-test --clusterrole=cluster-admin --serviceaccount=default:arkham-test >/dev/null
token=$(kubectl create token arkham-test --duration=3600s)
user=$(kubectl config view -o 'jsonpath={.users[0].name}')
export KUBECONFIG="$scratch/token-kubeconfig"
kubectl config set-credentials "$user" --token="$token" >/dev/null
kubectl config unset "users.$user.client-certificate-data" >/dev/null
kubectl config unset "users.$user.client-key-data" >/dev/null

# Second bearer on the same API. Two token users share one server. The proxy
# tells them apart by the bearer.
export KUBECONFIG="$scratch/cert-kubeconfig"
kubectl create serviceaccount arkham-b >/dev/null
kubectl create clusterrolebinding arkham-b --clusterrole=cluster-admin --serviceaccount=default:arkham-b >/dev/null
token_b=$(kubectl create token arkham-b --duration=3600s)
ctx_a=$(KUBECONFIG="$scratch/token-kubeconfig" kubectl config current-context)
cluster_name=$(KUBECONFIG="$scratch/token-kubeconfig" kubectl config view --minify -o 'jsonpath={.clusters[0].name}')
cp "$scratch/token-kubeconfig" "$scratch/multi.yaml"
KUBECONFIG="$scratch/multi.yaml" kubectl config set-credentials arkham-b --token="$token_b" >/dev/null
KUBECONFIG="$scratch/multi.yaml" kubectl config set-context arkham-b --cluster="$cluster_name" --user=arkham-b >/dev/null
# kubectl stores a command under the kubeconfig directory as a relative path.
plugin_dir=$(mktemp -d)
cat >"$plugin_dir/exec-plugin" <<EOF
#!/bin/sh
printf '%s\n' '{"apiVersion":"client.authentication.k8s.io/v1","kind":"ExecCredential","status":{"token":"${token}"}}'
EOF
chmod +x "$plugin_dir/exec-plugin"
cp "$scratch/cert-kubeconfig" "$scratch/exec-kubeconfig"
KUBECONFIG="$scratch/exec-kubeconfig" kubectl config set-credentials "$user" \
  --exec-command="$plugin_dir/exec-plugin" \
  --exec-api-version=client.authentication.k8s.io/v1 \
  --exec-interactive-mode=Never >/dev/null
KUBECONFIG="$scratch/exec-kubeconfig" kubectl config unset "users.$user.client-certificate-data" >/dev/null
KUBECONFIG="$scratch/exec-kubeconfig" kubectl config unset "users.$user.client-key-data" >/dev/null
KUBECONFIG="$scratch/exec-kubeconfig" kubectl config unset "users.$user.token" >/dev/null

# One leg: init a workspace against a kubeconfig source, serve host-side, and
# prove the three states. Real works direct, decoy fails direct, decoy works
# through the proxy. Host-side serve cannot resolve the /arkham/grants container
# mount, so the layer runs as a copy with host paths. Substitution behavior
# is unaffected by the prefix.
run_leg() {
  local name=$1 source=$2 port=$3
  local ws=$scratch/ws-$name
  mkdir -p "$ws/.config/arkham"
  printf '%s\n' '[[workspace.file_rewrite]]' "source = \"$source\"" 'dest = "{home}/.kube/config"' 'format = "kubeconfig"' >"$ws/.config/arkham/config.toml"
  # Redirects stay on the arkham invocations only: XDG_CONFIG_HOME breaks the
  # mise shims kubectl and k3d run through, so those keep the real environment.
  local statedir=$scratch/state-$name
  # The task exports KUBECONFIG as the cert file for kubectl. Init must see
  # this leg's source, which is already a declared rewrite, so ambient
  # discovery does not add the cert user on the same API server.
  KUBECONFIG="$source" XDG_STATE_HOME=$statedir XDG_CONFIG_HOME=$scratch/config FNOX_CONFIG_DIR=$scratch/fnox "$arkham" init --backend tproxy "$ws"
  shopt -s nullglob
  kubedirs=()
  for d in "$statedir"/arkham/ws/*/grants; do kubedirs+=("$d"); done
  decoys=()
  for d in "$statedir"/arkham/ws/*/files/00-*; do decoys+=("$d"); done
  shopt -u nullglob
  if [ "${#kubedirs[@]}" -ne 1 ] || [ "${#decoys[@]}" -ne 1 ]; then
    echo "init generated no kube state under $XDG_STATE_HOME" >&2
    exit 1
  fi
  local kubedir=${kubedirs[0]} decoy=${decoys[0]}
  if grep -Eq 'client-certificate-data|client-key-data|exec:|auth-provider:' "$decoy"; then
    echo "guest kubeconfig kept host auth" >&2
    exit 1
  fi
  sed "s|/arkham/grants|$kubedir|" "$kubedir/arkham.toml" >"$scratch/host-layer-$name.toml"
  cp "$decoy" "$scratch/proxy-$name.yaml"
  local context
  context=$(KUBECONFIG="$source" kubectl config current-context)
  KUBECONFIG="$scratch/proxy-$name.yaml" kubectl config set-cluster "$context" --proxy-url="http://127.0.0.1:$port" >/dev/null

  XDG_STATE_HOME=$statedir FNOX_CONFIG_DIR=$scratch/fnox ARKHAM_CONFIG="$scratch/host-layer-$name.toml" ARKHAM_CA_FILE="$scratch/config/arkham/ca.pem" ARKHAM_LISTEN="127.0.0.1:$port" "$arkham" serve &
  serve_pid=$!
  sleep 2

  echo "--- $name: real credential works direct"
  KUBECONFIG="$source" kubectl get nodes --request-timeout=30s
  echo "--- $name: decoy fails direct"
  if env -u HTTPS_PROXY -u https_proxy -u HTTP_PROXY -u http_proxy KUBECONFIG="$decoy" kubectl get nodes --request-timeout=30s; then
    echo "decoy kubeconfig worked without the proxy; substitution unproven" >&2
    exit 1
  fi
  echo "--- $name: decoy works through the proxy"
  KUBECONFIG="$scratch/proxy-$name.yaml" kubectl get nodes --request-timeout=30s

  kill "$serve_pid" 2>/dev/null || true
  serve_pid=""
}

run_discovered() {
  local name=$1 port=$2 kubeconfig=$3
  shift 3
  local ws=$scratch/ws-$name
  mkdir -p "$ws/.config/arkham"
  printf '%s\n' '[workspace]' >"$ws/.config/arkham/config.toml"
  local statedir=$scratch/state-$name
  KUBECONFIG="$kubeconfig" XDG_STATE_HOME=$statedir XDG_CONFIG_HOME=$scratch/config FNOX_CONFIG_DIR=$scratch/fnox "$arkham" init --backend tproxy "$ws"
  shopt -s nullglob
  local kubedirs=() decoys=()
  for d in "$statedir"/arkham/ws/*/grants; do kubedirs+=("$d"); done
  for d in "$statedir"/arkham/ws/*/files/kube-config; do decoys+=("$d"); done
  shopt -u nullglob
  if [ "${#kubedirs[@]}" -ne 1 ] || [ "${#decoys[@]}" -ne 1 ]; then
    echo "init did not discover a kubeconfig from KUBECONFIG=${kubeconfig}" >&2
    exit 1
  fi
  local kubedir=${kubedirs[0]} decoy=${decoys[0]}
  sed "s|/arkham/grants|${kubedir}|" "$kubedir/arkham.toml" >"$scratch/host-layer-$name.toml"
  cp "$decoy" "$scratch/proxy-$name.yaml"
  local discovered
  discovered=$(KUBECONFIG="$kubeconfig" kubectl config view -o 'jsonpath={.clusters[0].name}')
  KUBECONFIG="$scratch/proxy-$name.yaml" kubectl config set-cluster "$discovered" --proxy-url="http://127.0.0.1:$port" >/dev/null

  XDG_STATE_HOME=$statedir FNOX_CONFIG_DIR=$scratch/fnox ARKHAM_CONFIG="$scratch/host-layer-$name.toml" ARKHAM_CA_FILE="$scratch/config/arkham/ca.pem" ARKHAM_LISTEN="127.0.0.1:$port" "$arkham" serve &
  serve_pid=$!
  sleep 2

  local ctx
  echo "--- ${name}: real credentials work direct"
  for ctx in "$@"; do
    KUBECONFIG="$kubeconfig" kubectl --context "$ctx" get nodes --request-timeout=30s
  done
  echo "--- ${name}: decoy fails direct"
  if env -u HTTPS_PROXY -u https_proxy -u HTTP_PROXY -u http_proxy KUBECONFIG="$decoy" kubectl --context "$1" get nodes --request-timeout=30s; then
    echo "decoy kubeconfig worked without the proxy; substitution unproven" >&2
    exit 1
  fi
  echo "--- ${name}: decoy works through the proxy"
  for ctx in "$@"; do
    KUBECONFIG="$scratch/proxy-$name.yaml" kubectl config use-context "$ctx" >/dev/null
    KUBECONFIG="$scratch/proxy-$name.yaml" kubectl get nodes --request-timeout=30s
  done

  kill "$serve_pid" 2>/dev/null || true
  serve_pid=""
}

run_leg cert "$scratch/cert-kubeconfig" 18099
run_leg bearer "$scratch/token-kubeconfig" 18100
run_leg exec "$scratch/exec-kubeconfig" 18103
run_discovered multi 18101 "$scratch/multi.yaml" "$ctx_a" arkham-b

echo "k3s substitution proven: bearer, cert, exec, multi-context"
