#!/usr/bin/env bash

#MISE description="Run the NATS e2e scenarios with eBPF capture"
#MISE sources=["Cargo.toml", "Cargo.lock", "src/**", "crates/**", "integration/**"]
#MISE outputs=[]
#MISE depends=["build:debug"]
#MISE dir="{{config_root}}"

set -euo pipefail
source integration/e2e.sh

