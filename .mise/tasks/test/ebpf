#!/usr/bin/env bash

#MISE description="Run the live eBPF capture tests (build as user, execute as root)"
#MISE sources=["Cargo.toml", "Cargo.lock", "src/**", "crates/**", "rules/**", ".mise/tasks/test/**"]
#USAGE flag "--use-sudo" help="Skip the gum escalation prompt and go straight to sudo"
#USAGE arg "[filters]" var=#true help="Test-name filters; default: ebpf_live_"

proj_dir=$(jj root 2>/dev/null || git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

# Build the test binary as the current user so target/ stays user-owned.
# Building this package is also what runs its `build.rs`, and therefore
# `aya-build`, so the BPF programs are compiled here.
cargo nextest run --locked --no-run --cargo-quiet --package arkham-ebpf

# Locate `arkham-ebpf`'s own test binary: the workspace has many, so the package
# filter is what makes the "exactly one" assertion meaningful.
test_bin=$(cargo nextest list --package arkham-ebpf --message-format json |
  jq -r '.["rust-suites"] |
  if length == 1 then first(.[]) | .["binary-path"] else error("expected 1 test binary, got \(length)") end')

# Default to the ebpf_live_ prefix unless the caller narrows it.
eval "filters=(${usage_filters:-})"
if [ ${#filters[@]} -eq 0 ]; then
  filters=(ebpf_live_)
fi

# Host firewall rules and routes must not affect the capture fixtures.
runner=(unshare --net -- bash -c 'set -e; ip link set lo up; exec "$@"' bash
  "$test_bin" --test-threads=1 --ignored "${filters[@]}")

# Root is needed for bpf(2) and for creating a cgroup and writing to its
# `cgroup.procs`.
if [ "${usage_use_sudo:-false}" = "true" ]; then
  sudo "${runner[@]}"
else
  if ! gum confirm "eBPF tests need root (bpf syscall, cgroup writes); escalate with sudo?"; then
    echo "escalation declined; test binary: $test_bin" >&2
    exit 1
  fi
  sudo "${runner[@]}"
fi
