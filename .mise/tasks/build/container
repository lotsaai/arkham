#!/usr/bin/env bash

#MISE description="Build and smoke-check the container binary"
#MISE sources=["Dockerfile", ".cargo/**", "mise.lock", "Cargo.toml", "Cargo.lock", "src/**", "crates/**", "rules/**"]
#MISE outputs=["target/container/release/arkham", "target/container/.built"]

proj_dir=$(jj root 2>/dev/null || git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

mkdir -p target/container/cargo

docker run --rm -i --entrypoint bash \
  --volume "$proj_dir:/workspace:ro" \
  --volume "$proj_dir/target/container:/workspace/target/container" \
  --volume "$proj_dir/target/container/cargo:/cargo" \
  --workdir /workspace \
  ghcr.io/casualjim/rust-builder -s -- "$(id -u)" "$(id -g)" <<'BUILD'
set -euo pipefail

apt-get update
apt-get install -y --no-install-recommends zstd
nightly=$(python3 -c 'import tomllib; print(next(t["version"] for t in tomllib.load(open("mise.lock", "rb"))["tools"]["rust"] if t["version"].startswith("nightly")))')
rustup toolchain install "$nightly" --profile minimal --component rust-src --component llvm-tools
curl -fsSL "https://github.com/aya-rs/bpf-linker/releases/latest/download/bpf-linker-$(uname -m)-unknown-linux-musl.tar.zst" \
  | tar --zstd -x -C /usr/local/bin

exec setpriv --reuid="$1" --regid="$2" --clear-groups env \
  HOME=/tmp CARGO_HOME=/cargo RUSTC_WRAPPER= \
  CARGO_TARGET_DIR=/workspace/target/container \
  CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=clang \
  CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=clang \
  CXXFLAGS=-stdlib=libstdc++ CXXSTDLIB=stdc++ BORING_BSSL_RUST_CPPLIB=stdc++ \
  cargo build --locked --release --bin arkham
BUILD

# Exercise the actual runtime loader, including every dynamic dependency.
docker run --rm \
  --volume "$proj_dir/target/container/release/arkham:/usr/local/bin/arkham:ro" \
  --entrypoint /usr/local/bin/arkham \
  ghcr.io/casualjim/bare:libcxx-udev-ssl --help >/dev/null
touch target/container/.built
