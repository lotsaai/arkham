amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Builtins.pkl"

local rust_steps = new Mapping<String, Step> {

  ["cargo-check"] = (Builtins.cargo_check) {
    // `--workspace` because the root package doubles as the workspace root, so
    // a bare `cargo check --all-targets` would cover only the root binary:
    // every crate's unit tests would go unchecked.
    // `--exclude arkham-ebpf-programs` because that crate is a workspace member
    // only so `aya-build` can resolve it with `--package`; it compiles for the
    // `bpf` target alone, and building it for the host fails on the panic
    // handler. `aya-build` builds it as part of `arkham-ebpf`, so the gate still
    // covers it.
    check = "cargo check --workspace --exclude arkham-ebpf-programs --all-targets"
    fix = "cargo check --workspace --exclude arkham-ebpf-programs --all-targets"
    depends = "rustfmt"
    check_first = true
  }

  ["cargo-clippy"] = new Step {
    glob = List("**/*.rs")
    stage = List("**/*.rs")
    check = "cargo clippy --workspace --exclude arkham-ebpf-programs --all-targets -- -D warnings"
    fix = "cargo clippy --workspace --exclude arkham-ebpf-programs --all-targets --fix --allow-dirty --allow-staged -- -D warnings"
    check_first = true
    depends = "cargo-check"
  }

  ["rustfmt"] = new Step {
    glob = List("**/*.rs")
    stage = List("**/*.rs")
    check = "rustfmt --edition 2024 --check {{files}}"
    fix = "rustfmt --edition 2024 {{files}}"
    depends = "cargo-sort"
  }

  ["cargo-sort"] = new Step {
    glob = List("**/Cargo.toml")
    stage = List("**/Cargo.toml")
    check = "cargo sort --grouped --check ."
    fix = "cargo sort --grouped ."
    check_first = true
  }

}

local project_steps = new Mapping<String, Step> {
  ...rust_steps

  ["shellcheck"] = Builtins.shellcheck

  ["hadolint"] = Builtins.hadolint

  ["lychee"] = new Step {
    glob = List("**/*.md")
    // Vendored tool skills under .agents/ are upstream text we don't own;
    // their links rot independently of this repo and 503-flake the gate.
    // Excluded here (not via --exclude-path) so lychee never receives them:
    // it warns "no files found" for every input it filters out itself.
    exclude = List(".agents/**")
    check = "lychee {{files}}"
  }

  ["check-toml"] = (Builtins.taplo) {
    glob = List("**/*.toml")
  }

  ["cargo-audit"] = new Step {
    // The lockfile is the supply-chain surface. Vulnerabilities fail the
    // gate; unmaintained/yanked advisories stay warnings so the daily
    // advisory-db drift cannot flake pre-commit the way a red network
    // check would.
    check = "mise run audit"
  }

  ["betterleaks"] = new Step {
    // Owned trees only, named explicitly: `docs/` and `integration/` carry
    // credential-shaped fixtures by design, and the derived trees (`.cache/`,
    // `target/`, `.git/`) hold ~15 GB of vendored bytes nobody wants walked.
    // Fixture literals inside the scanned trees carry inline
    // `betterleaks:allow` markers, so a new token-shaped literal in real
    // code still fails the gate. v1.9's global prefilter/filter config keys
    // are not consulted by `dir` scans — do not reintroduce a config file
    // hoping they work.
    check = "betterleaks dir --no-banner src crates rules examples .mise .github"
  }

  ["check-merge-conflict"] = Builtins.check_merge_conflict

  ["check-added-large-files"] = Builtins.check_added_large_files
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = project_steps
  }

  ["check"] {
    steps = project_steps
  }

  ["fix"] {
    fix = true
    steps = project_steps
  }
}
